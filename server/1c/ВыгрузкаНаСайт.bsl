// ===== Умари Хайём — выгрузка товаров из 1С:Розница на сайт =====
// Вставить целиком в «Модуль объекта» внешней обработки «ВыгрузкаНаСайт».
// Заполните три настройки ниже. Ключ обмена берётся на сайте:
// «Каталог» → «🔄 Товары из 1С» → «⚙️ Настройка обмена с 1С» → «Выдать ключ обмена».

// ---------- НАСТРОЙКИ ----------
Функция АдресСервера()
	Возврат "https://script.google.com/macros/s/AKfycbzxbho2rc1WmpPRcsMGcKcbxdjH4AgJzxaOU_4R8PvEi5_x45vfRO2vP2nXRR5QKojg/exec";
КонецФункции

Функция КлючОбмена()
	Возврат "ВСТАВЬТЕ_СЮДА_КЛЮЧ_ОБМЕНА";
КонецФункции

Функция ИмяВидаЦены()
	// как называется вид цены в 1С: «НСИ» → «Виды цен». Обычно «Розничная».
	Возврат "Розничная";
КонецФункции

// ---------- РЕГИСТРАЦИЯ В «ДОПОЛНИТЕЛЬНЫХ ОБРАБОТКАХ» ----------
Функция СведенияОВнешнейОбработке() Экспорт
	П = ДополнительныеОтчетыИОбработки.СведенияОВнешнейОбработке();
	П.Вид = ДополнительныеОтчетыИОбработкиКлиентСервер.ВидОбработкиДополнительнаяОбработка();
	П.Версия = "1.0";
	П.Наименование = "Выгрузка товаров на сайт Умари Хайём";
	П.Информация = "Отправляет товары (код, артикул, название, группа, единица, цена, штрихкоды) на сайт.";
	П.БезопасныйРежим = Ложь;
	Команда = П.Команды.Добавить();
	Команда.Представление = "Выгрузить товары на сайт";
	Команда.Идентификатор = "Выгрузка";
	Команда.Использование = ДополнительныеОтчетыИОбработкиКлиентСервер.ТипКомандыВызовСерверногоМетода();
	Команда.ПоказыватьОповещение = Истина;
	Возврат П;
КонецФункции

Процедура ВыполнитьКоманду(ИдентификаторКоманды, ПараметрыВыполненияКоманды) Экспорт
	ВыгрузитьТовары();
КонецПроцедуры

// ---------- ВЫГРУЗКА ----------
Процедура ВыгрузитьТовары() Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Н.Ссылка КАК Ссылка,
	|	Н.Код КАК Код,
	|	Н.Артикул КАК Артикул,
	|	Н.Наименование КАК Наименование,
	|	ЕСТЬNULL(Н.Родитель.Наименование, """") КАК Группа,
	|	ПРЕДСТАВЛЕНИЕ(Н.ЕдиницаИзмерения) КАК Единица,
	|	Н.ПометкаУдаления КАК Удален,
	|	ЕСТЬNULL(Цены.Цена, 0) КАК Цена
	|ИЗ
	|	Справочник.Номенклатура КАК Н
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			Ц.Номенклатура КАК Номенклатура,
	|			МАКСИМУМ(Ц.Цена) КАК Цена
	|		ИЗ
	|			РегистрСведений.ЦеныНоменклатуры.СрезПоследних(, ВидЦены.Наименование = &ВидЦены) КАК Ц
	|		СГРУППИРОВАТЬ ПО
	|			Ц.Номенклатура) КАК Цены
	|		ПО (Цены.Номенклатура = Н.Ссылка)
	|ГДЕ
	|	НЕ Н.ЭтоГруппа
	|
	|УПОРЯДОЧИТЬ ПО
	|	Код";
	Запрос.УстановитьПараметр("ВидЦены", ИмяВидаЦены());
	Товары = Запрос.Выполнить().Выгрузить();

	// штрихкоды
	ЗапросШК = Новый Запрос;
	ЗапросШК.Текст =
	"ВЫБРАТЬ
	|	Ш.Номенклатура КАК Номенклатура,
	|	Ш.Штрихкод КАК Штрихкод
	|ИЗ
	|	РегистрСведений.ШтрихкодыНоменклатуры КАК Ш";
	ШК = Новый Соответствие;
	Выборка = ЗапросШК.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Список = ШК.Получить(Выборка.Номенклатура);
		Если Список = Неопределено Тогда
			Список = Новый Массив;
			ШК.Вставить(Выборка.Номенклатура, Список);
		КонецЕсли;
		Если Список.Количество() < 10 Тогда
			Список.Добавить(СокрЛП(Выборка.Штрихкод));
		КонецЕсли;
	КонецЦикла;

	// отправляем частями по 500 товаров
	Размер = 500;
	Всего = Товары.Количество();
	Частей = Цел((Всего + Размер - 1) / Размер);
	Если Частей = 0 Тогда
		Сообщить("В 1С нет товаров для выгрузки");
		Возврат;
	КонецЕсли;
	Новых = 0; Изменено = 0;
	Для Часть = 1 По Частей Цикл
		Массив = Новый Массив;
		Для Н = (Часть - 1) * Размер По Мин(Часть * Размер, Всего) - 1 Цикл
			Т = Товары[Н];
			Эл = Новый Структура;
			Эл.Вставить("code", СокрЛП(Т.Код));
			Эл.Вставить("art", СокрЛП(Т.Артикул));
			Эл.Вставить("n", СокрЛП(Т.Наименование));
			Эл.Вставить("grp", СокрЛП(Т.Группа));
			Эл.Вставить("ub", СокрЛП(Т.Единица));
			Эл.Вставить("p", Т.Цена);
			Список = ШК.Получить(Т.Ссылка);
			Эл.Вставить("bc", ?(Список = Неопределено, Новый Массив, Список));
			Эл.Вставить("del", Т.Удален);
			Массив.Добавить(Эл);
		КонецЦикла;
		Пакет = Новый Структура("a,k1,part,of,items", "c1_put", КлючОбмена(), Часть, Частей, Массив);
		Ответ = ОтправитьНаСайт(Пакет);
		Если Ответ = Неопределено Тогда
			ВызватьИсключение "Сайт не ответил. Проверьте интернет и адрес сервера.";
		ИначеЕсли НЕ Ответ.Свойство("ok") ИЛИ НЕ Ответ.ok Тогда
			Ошибка = ""; Ответ.Свойство("error", Ошибка);
			ВызватьИсключение "Сайт отклонил выгрузку: " + ?(Ошибка = "key", "неверный ключ обмена", Ошибка);
		КонецЕсли;
		Если Ответ.Свойство("add") Тогда Новых = Новых + Ответ.add; КонецЕсли;
		Если Ответ.Свойство("upd") Тогда Изменено = Изменено + Ответ.upd; КонецЕсли;
	КонецЦикла;
	Итог = "Выгружено на сайт: " + Формат(Всего, "ЧГ=0") + " товаров. Новых: " + Новых + ", изменено: " + Изменено + ".";
	Сообщить(Итог);
	ЗаписьЖурналаРегистрации("Выгрузка на сайт", УровеньЖурналаРегистрации.Информация, , , Итог);
КонецПроцедуры

// ---------- СВЯЗЬ С САЙТОМ ----------
Функция ОтправитьНаСайт(Пакет)
	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Пакет);
	Текст = Запись.Закрыть();

	Адрес = АдресСервера();
	Для Шаг = 1 По 6 Цикл
		Адрес = СтрЗаменить(Адрес, "https://", "");
		Поз = СтрНайти(Адрес, "/");
		Хост = Лев(Адрес, Поз - 1);
		Путь = Сред(Адрес, Поз);
		Попытка
			Сертификаты = Новый СертификатыУдостоверяющихЦентровОС;
			SSL = Новый ЗащищенноеСоединениеOpenSSL(, Сертификаты);
		Исключение
			SSL = Новый ЗащищенноеСоединениеOpenSSL;
		КонецПопытки;
		Соединение = Новый HTTPСоединение(Хост, 443, , , , 180, SSL);
		Запрос = Новый HTTPЗапрос(Путь);
		Если Шаг = 1 Тогда
			Запрос.Заголовки.Вставить("Content-Type", "text/plain; charset=utf-8");
			Запрос.УстановитьТелоИзСтроки(Текст, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
			Ответ = Соединение.ОтправитьДляОбработки(Запрос);
		Иначе
			Ответ = Соединение.Получить(Запрос);
		КонецЕсли;
		Код = Ответ.КодСостояния;
		Если Код = 301 ИЛИ Код = 302 ИЛИ Код = 303 ИЛИ Код = 307 ИЛИ Код = 308 Тогда
			// Google переадресует за ответом на другой адрес — идём туда
			Новый_ = Ответ.Заголовки.Получить("Location");
			Если Новый_ = Неопределено Тогда Новый_ = Ответ.Заголовки.Получить("location"); КонецЕсли;
			Если Новый_ = Неопределено Тогда Возврат Неопределено; КонецЕсли;
			Адрес = Новый_;
			Продолжить;
		КонецЕсли;
		Если Код <> 200 Тогда
			ВызватьИсключение "Сайт ответил с ошибкой " + Код;
		КонецЕсли;
		Чтение = Новый ЧтениеJSON;
		Чтение.УстановитьСтроку(Ответ.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8));
		Результат = ПрочитатьJSON(Чтение);
		Чтение.Закрыть();
		Возврат Результат;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции
